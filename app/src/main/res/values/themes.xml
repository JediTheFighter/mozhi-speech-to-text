<resources>
    <style name="Theme.Mozhi" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/night_ink</item>
        <item name="android:windowBackground">@color/night_ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Mozhi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mozhi</item>
    </style>
</resources>
